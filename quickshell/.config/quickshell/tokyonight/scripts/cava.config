# cava config for the waybar visualizer (custom/cava module).
# Standalone terminal usage keeps the default ~/.config/cava/config.

[general]
bars = 8
autosens = 1

[input]
method = pipewire
source = auto

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii      ; emit bar values as text, not binary
ascii_max_range = 7      ; 0..7 -> directly index the 8 block glyphs
bar_delimiter = 59       ; ';' between bars
frame_delimiter = 10     ; newline at end of each frame